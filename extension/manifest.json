{
  "name": "Zalo Credentials Extractor",
  "version": "1.0.0",
  "description": "Extract cookies and IMEI from Zalo Web for use with zalo-client",
  "manifest_version": 3,
  "permissions": [
    "cookies",
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://chat.zalo.me/*",
    "https://*.zalo.me/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Zalo Credentials Extractor",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.zalo.me/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["https://chat.zalo.me/*"]
    }
  ]
}
